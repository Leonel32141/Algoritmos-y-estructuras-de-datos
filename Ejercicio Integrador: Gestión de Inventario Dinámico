import random

inventario = {
    "computadoras": [("laptop", 3), ("pc gamer", 2), ("notebook", 5)],
    "accesorios": [("mouse", 10), ("teclado", 6), ("auriculares", 4)],
    "periféricos": [("monitor", 2), ("impresora", 1), ("parlantes", 3)]
}

print("Inventario inicial:")
for categoria, productos in inventario.items():
    print(f"{categoria}: {productos}")
print("-" * 40)

for i in range(3):
    categoria = random.choice(list(inventario.keys()))
    if not inventario[categoria]:
        continue
    producto = random.choice(inventario[categoria])
    nombre, cantidad = producto
    jaja = inventario[categoria].index(producto)
    inventario[categoria].pop(jaja)
    if cantidad > 1:
        inventario[categoria].append((nombre, cantidad - 1))
    print(f"Venta {i+1}: {nombre} (categoría: {categoria})")

print("-" * 40)

inventario["accesorios"].append(("cargador USB", 7))
print("Reposición: agregado 'cargador USB' en 'accesorios'")
print("-" * 40)

print("Inventario final:")
for categoria, productos in inventario.items():
    if productos:
        print(f"{categoria}: {productos}")
    else:
        print(f"{categoria}: Sin productos")    
